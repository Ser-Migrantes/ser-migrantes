{
  "name": "Evento",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "description": "Tipo de interacci\u00f3n registrada",
      "enum": [
        "visita",
        "busqueda",
        "clic_servicio",
        "clic_relato",
        "solicitud"
      ]
    },
    "referencia": {
      "type": "string",
      "description": "P\u00e1gina, servicio o relato implicado"
    },
    "termino": {
      "type": "string",
      "description": "T\u00e9rmino buscado o casu\u00edstica seleccionada"
    },
    "fecha": {
      "type": "string",
      "description": "Momento del evento",
      "format": "date-time"
    }
  },
  "required": [
    "tipo"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}